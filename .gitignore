!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Virtual Environment
.venv/

# ── Godot ────────────────────────────────────────────────────────────────────
# Godot auto-generated import cache (recreated locally by the editor)
*.import
# Godot editor metadata & local settings
.godot/
# Blender auto-backup files (not source-of-truth)
*.blend1
*.blend2

# Raw asset dump directory
client/dump/

# ── Scratch / one-off dev scripts ────────────────────────────────────────────
# These are throwaway investigation scripts, not part of the project
scratch/

# ── Loose debug/test scripts at client root ──────────────────────────────────
# One-off GDScript debug files dumped at the project root during development
client/check_*.gd
client/check_*.gd.uid
client/inspect_*.gd
client/inspect_*.gd.uid
client/test_attach.gd
client/test_attach.gd.uid

# ── Binary archives ───────────────────────────────────────────────────────────
# Zip archives of assets (raw assets tracked individually instead)
client/assets/character_models/*.zip


