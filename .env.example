# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # required — your DeepSeek (or compatible) API key
LLM_BASE_URL=https://api.deepseek.com         # base URL for the OpenAI-compatible chat endpoint
LLM_MODEL=deepseek-chat                       # model name passed to the API

# ── Database ─────────────────────────────────────────────────────────────────
DB_URL=sqlite+aiosqlite:///./threshold.db     # SQLAlchemy async connection string

# ── Progression ──────────────────────────────────────────────────────────────
XP_PER_LEVEL=100                              # XP required to advance one player level
MAX_LEVEL=100                                 # hard cap on player level

# ── Encounter ────────────────────────────────────────────────────────────────
MAX_TURNS_PER_ENCOUNTER=6                     # maximum player/NPC exchanges per session
