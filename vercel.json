{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/game/(.*)",
      "dest": "/game/$1"
    },
    {
      "src": "/game$",
      "dest": "/game/index.html"
    },
    {
      "src": "/game/",
      "dest": "/game/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
