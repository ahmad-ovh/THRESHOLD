{
  "redirects": [
    {
      "source": "/",
      "destination": "/game/",
      "permanent": false
    },
    {
      "source": "/game",
      "destination": "/game/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/game/(.*)\\.(pck|wasm|js|png|jpg|jpeg|hdr|svg|worklet\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/game/",
      "destination": "/game/index.html"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/interaction/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/player/:path*",
      "destination": "/api/index.py"
    }
  ]
}
